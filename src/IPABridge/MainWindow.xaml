<Window x:Class="IPABridge.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:models="clr-namespace:IPABridge.Models"
        xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
        xmlns:views="clr-namespace:IPABridge.Views"
        Title="IPA Bridge"
        Icon="pack://application:,,,/Assets/IPA-Bridge.ico"
        Width="1120"
        Height="670"
        MinWidth="960"
        MinHeight="580"
        WindowStartupLocation="CenterScreen"
        WindowStyle="None"
        ResizeMode="CanResize"
        Background="{StaticResource WindowBackgroundGradient}"
        UseLayoutRounding="True"
        SnapsToDevicePixels="True"
        mc:Ignorable="d">
  <shell:WindowChrome.WindowChrome>
    <shell:WindowChrome CaptionHeight="54"
                        CornerRadius="18"
                        GlassFrameThickness="0"
                        ResizeBorderThickness="7"
                        UseAeroCaptionButtons="False" />
  </shell:WindowChrome.WindowChrome>

  <Window.Resources>
    <DataTemplate x:Key="DashboardTemplate">
      <views:DashboardView />
    </DataTemplate>
    <DataTemplate x:Key="StoreTemplate">
      <views:StoreView />
    </DataTemplate>
    <DataTemplate x:Key="LibraryTemplate">
      <views:LibraryView />
    </DataTemplate>
    <DataTemplate x:Key="DevicesTemplate">
      <views:DevicesView />
    </DataTemplate>
    <DataTemplate x:Key="SettingsTemplate">
      <views:SettingsView />
    </DataTemplate>
  </Window.Resources>

  <Border Background="#BFF7F9FD"
          BorderBrush="#99FFFFFF"
          BorderThickness="1"
          CornerRadius="18">
    <Grid>
      <Grid.RowDefinitions>
        <RowDefinition Height="54" />
        <RowDefinition Height="*" />
      </Grid.RowDefinitions>

      <Grid Grid.Row="0">
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="246" />
          <ColumnDefinition Width="*" />
          <ColumnDefinition Width="Auto" />
        </Grid.ColumnDefinitions>

        <StackPanel Grid.Column="0"
                    Margin="18,0,0,0"
                    VerticalAlignment="Center"
                    Orientation="Horizontal">
          <Image x:Name="BrandIconImage"
                 Width="31"
                 Height="31"
                 AutomationProperties.Name="IPA Bridge icon"
                 RenderOptions.BitmapScalingMode="HighQuality"
                 Source="pack://application:,,,/Assets/IPA-Bridge.png"
                 Stretch="Uniform"
                 SnapsToDevicePixels="True" />
          <TextBlock Margin="10,0,0,0"
                     VerticalAlignment="Center"
                     FontSize="15"
                     FontWeight="SemiBold"
                     Text="IPA Bridge" />
        </StackPanel>

        <Border Grid.Column="1"
                HorizontalAlignment="Right"
                VerticalAlignment="Center"
                Margin="0,0,12,0"
                Padding="11,5"
                Background="#A8FFFFFF"
                BorderBrush="#88FFFFFF"
                BorderThickness="1"
                CornerRadius="11">
          <StackPanel Orientation="Horizontal">
            <Ellipse Width="7"
                     Height="7"
                     Margin="0,0,7,0"
                     VerticalAlignment="Center"
                     Fill="{StaticResource GreenBrush}" />
            <TextBlock FontSize="11"
                       Foreground="{StaticResource TextSecondaryBrush}"
                       Text="{Binding OverallReadiness}" />
          </StackPanel>
        </Border>

        <StackPanel Grid.Column="2"
                    Margin="0,0,9,0"
                    VerticalAlignment="Center"
                    Orientation="Horizontal"
                    shell:WindowChrome.IsHitTestVisibleInChrome="True">
          <Button Style="{StaticResource TitleBarButtonStyle}"
                  AutomationProperties.Name="Minimize"
                  FontFamily="{StaticResource AppFont}"
                  FontSize="15"
                  Content="—"
                  Click="MinimizeButton_OnClick" />
          <Button Style="{StaticResource TitleBarButtonStyle}"
                  AutomationProperties.Name="Maximize or restore"
                  FontFamily="{StaticResource AppFont}"
                  FontSize="15"
                  Content="□"
                  Click="MaximizeButton_OnClick" />
          <Button Style="{StaticResource TitleBarButtonStyle}"
                  AutomationProperties.Name="Close"
                  FontFamily="{StaticResource AppFont}"
                  FontSize="17"
                  Content="×"
                  Click="CloseButton_OnClick" />
        </StackPanel>
      </Grid>

      <Grid Grid.Row="1">
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="246" />
          <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <Border Grid.Column="0"
                Margin="12,0,0,12"
                Padding="11,18"
                Background="#8CFFFFFF"
                BorderBrush="#8FFFFFFF"
                BorderThickness="1"
                CornerRadius="17">
          <Grid>
            <Grid.RowDefinitions>
              <RowDefinition Height="Auto" />
              <RowDefinition Height="*" />
              <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <TextBlock Margin="12,0,0,13"
                       Style="{StaticResource CaptionTextStyle}"
                       FontWeight="SemiBold"
                       Text="Workspace" />

            <ItemsControl Grid.Row="1" ItemsSource="{Binding NavigationItems}">
              <ItemsControl.ItemTemplate>
                <DataTemplate>
                  <Button Margin="0,0,0,5"
                          AutomationProperties.Name="{Binding Label}"
                          Style="{StaticResource NavigationButtonStyle}"
                          Command="{Binding DataContext.NavigateCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                          CommandParameter="{Binding Page}">
                    <Grid>
                      <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="29" />
                        <ColumnDefinition Width="*" />
                      </Grid.ColumnDefinitions>
                      <TextBlock VerticalAlignment="Center"
                                 FontFamily="{StaticResource SymbolFont}"
                                 FontSize="15"
                                 Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                                 Text="{Binding Glyph}" />
                      <TextBlock Grid.Column="1"
                                 VerticalAlignment="Center"
                                 Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                                 Text="{Binding Label}" />
                    </Grid>
                  </Button>
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>

            <Button x:Name="PrivacyCardButton"
                    Grid.Row="2"
                    Margin="3"
                    AutomationProperties.HelpText="Shows how IPA Bridge stores and protects its settings."
                    AutomationProperties.Name="Open privacy and local encryption information"
                    Style="{StaticResource PrivacyCardButtonStyle}"
                    ToolTip="Open privacy and local encryption information"
                    Click="PrivacyCardButton_OnClick">
              <Grid>
                <Grid.ColumnDefinitions>
                  <ColumnDefinition Width="28" />
                  <ColumnDefinition Width="*" />
                  <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <Border Width="25"
                        Height="25"
                        VerticalAlignment="Top"
                        Background="{StaticResource AccentSoftBrush}"
                        CornerRadius="8">
                  <TextBlock HorizontalAlignment="Center"
                             VerticalAlignment="Center"
                             FontFamily="{StaticResource SymbolFont}"
                             FontSize="12"
                             Foreground="{StaticResource AccentBrush}"
                             Text="&#xE72E;" />
                </Border>
                <StackPanel Grid.Column="1" Margin="8,0,6,0">
                  <TextBlock FontSize="12"
                             FontWeight="SemiBold"
                             Text="Privacy by design" />
                  <TextBlock Margin="0,4,0,0"
                             Style="{StaticResource CaptionTextStyle}"
                             TextWrapping="Wrap"
                             Text="View local encryption and data-handling details" />
                </StackPanel>
                <TextBlock Grid.Column="2"
                           VerticalAlignment="Center"
                           FontFamily="{StaticResource SymbolFont}"
                           FontSize="10"
                           Foreground="{StaticResource TextTertiaryBrush}"
                           Text="&#xE76C;" />
              </Grid>
            </Button>
          </Grid>
        </Border>

        <Grid Grid.Column="1" Margin="30,12,30,24">
          <Grid.RowDefinitions>
            <RowDefinition Height="76" />
            <RowDefinition Height="*" />
          </Grid.RowDefinitions>

          <Grid>
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="*" />
              <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <StackPanel VerticalAlignment="Center">
              <TextBlock Style="{StaticResource PageTitleStyle}" Text="{Binding PageTitle}" />
              <TextBlock Margin="1,3,0,0"
                         Style="{StaticResource BodyTextStyle}"
                         Text="{Binding PageSubtitle}" />
            </StackPanel>
            <Button Grid.Column="1"
                    AutomationProperties.Name="Refresh current page"
                    Width="40"
                    Height="40"
                    Padding="0"
                    VerticalAlignment="Center"
                    Style="{StaticResource GhostButtonStyle}"
                    FontFamily="{StaticResource AppFont}"
                    FontSize="18"
                    Content="↻"
                    ToolTip="Refresh all"
                    Command="{Binding RefreshAllCommand}" />
          </Grid>

          <ContentControl Grid.Row="1" Content="{Binding}">
            <ContentControl.Style>
              <Style TargetType="ContentControl">
                <Setter Property="ContentTemplate" Value="{StaticResource DashboardTemplate}" />
                <Style.Triggers>
                  <DataTrigger Binding="{Binding CurrentPage}" Value="{x:Static models:NavigationPage.Store}">
                    <Setter Property="ContentTemplate" Value="{StaticResource StoreTemplate}" />
                  </DataTrigger>
                  <DataTrigger Binding="{Binding CurrentPage}" Value="{x:Static models:NavigationPage.Library}">
                    <Setter Property="ContentTemplate" Value="{StaticResource LibraryTemplate}" />
                  </DataTrigger>
                  <DataTrigger Binding="{Binding CurrentPage}" Value="{x:Static models:NavigationPage.Devices}">
                    <Setter Property="ContentTemplate" Value="{StaticResource DevicesTemplate}" />
                  </DataTrigger>
                  <DataTrigger Binding="{Binding CurrentPage}" Value="{x:Static models:NavigationPage.Settings}">
                    <Setter Property="ContentTemplate" Value="{StaticResource SettingsTemplate}" />
                  </DataTrigger>
                </Style.Triggers>
              </Style>
            </ContentControl.Style>
          </ContentControl>
        </Grid>
      </Grid>
    </Grid>
  </Border>
</Window>
