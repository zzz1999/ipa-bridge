<UserControl x:Class="IPABridge.Views.LibraryView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <Grid Margin="0,0,8,14">
    <Border Style="{StaticResource CardStyle}">
      <Grid>
        <Grid.RowDefinitions>
          <RowDefinition Height="Auto" />
          <RowDefinition Height="*" />
          <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <Grid Margin="0,0,0,15">
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="Auto" />
          </Grid.ColumnDefinitions>
          <StackPanel>
            <TextBlock Style="{StaticResource SectionTitleStyle}" Text="Local IPAs" />
            <TextBlock Margin="0,4,0,0"
                       Style="{StaticResource BodyTextStyle}"
                       Text="{Binding Library.StatusMessage}"
                       TextWrapping="Wrap" />
          </StackPanel>
          <StackPanel Grid.Column="1" Orientation="Horizontal">
            <Button Margin="0,0,8,0"
                    Style="{StaticResource GhostButtonStyle}"
                    Click="OpenDownloadDirectory_OnClick"
                    Content="Open Download Folder" />
            <Button Margin="0,0,8,0"
                    Style="{StaticResource SecondaryButtonStyle}"
                    Click="ChooseExternalIpa_OnClick"
                    Content="Choose Another IPA" />
            <Button AutomationProperties.Name="Refresh IPA library"
                    Style="{StaticResource RoundedIconButtonStyle}"
                    ToolTip="Refresh IPA library"
                    Command="{Binding Library.RefreshCommand}">
              <Viewbox Width="22" Height="22" IsHitTestVisible="False">
                <Grid Width="24" Height="24">
                  <Path Data="{StaticResource RefreshIconGeometry}"
                        Style="{StaticResource RoundedButtonIconStyle}" />
                </Grid>
              </Viewbox>
            </Button>
          </StackPanel>
        </Grid>

        <ListBox Grid.Row="1" ItemsSource="{Binding Library.Items}">
          <ListBox.ItemTemplate>
            <DataTemplate>
              <Grid>
                <Grid.ColumnDefinitions>
                  <ColumnDefinition Width="62" />
                  <ColumnDefinition Width="*" />
                  <ColumnDefinition Width="150" />
                  <ColumnDefinition Width="145" />
                </Grid.ColumnDefinitions>
                <Border Width="50"
                        Height="50"
                        Background="#E9E5FF"
                        CornerRadius="16">
                  <TextBlock HorizontalAlignment="Center"
                             VerticalAlignment="Center"
                             FontFamily="{StaticResource SymbolFont}"
                             FontSize="21"
                             Foreground="{StaticResource PurpleBrush}"
                             Text="&#xE8B7;" />
                </Border>
                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                  <TextBlock FontSize="14"
                             FontWeight="SemiBold"
                             Text="{Binding Name}"
                             TextTrimming="CharacterEllipsis" />
                  <TextBlock Margin="0,3,16,0"
                             Style="{StaticResource CaptionTextStyle}"
                             Text="{Binding FilePath}"
                             TextTrimming="CharacterEllipsis" />
                </StackPanel>
                <StackPanel Grid.Column="2" VerticalAlignment="Center">
                  <TextBlock FontSize="12" FontWeight="SemiBold" Text="{Binding SizeLabel}" />
                  <TextBlock Margin="0,3,0,0"
                             Style="{StaticResource CaptionTextStyle}"
                             Text="{Binding ModifiedAt, StringFormat={}{0:yyyy-MM-dd HH:mm}}" />
                </StackPanel>
                <Button Grid.Column="3"
                        VerticalAlignment="Center"
                        Style="{StaticResource PrimaryButtonStyle}"
                        Command="{Binding DataContext.QueueIpaCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                        CommandParameter="{Binding}"
                        Content="Install on Device" />
              </Grid>
            </DataTemplate>
          </ListBox.ItemTemplate>
        </ListBox>

        <Border Grid.Row="2"
                Margin="0,14,0,0"
                Padding="16"
                Background="#EEF3FA"
                CornerRadius="18">
          <Grid>
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="Auto" />
              <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <TextBlock Margin="0,0,10,0"
                       FontFamily="{StaticResource SymbolFont}"
                       FontSize="17"
                       Foreground="{StaticResource AccentBrush}"
                       Text="&#xE946;" />
            <TextBlock Grid.Column="1"
                       Style="{StaticResource CaptionTextStyle}"
                       Text="App Store IPAs remain subject to FairPlay, signing, account authorization, and device policy. IPA Bridge does not crack or bypass these restrictions."
                       TextWrapping="Wrap" />
          </Grid>
        </Border>
      </Grid>
    </Border>
  </Grid>
</UserControl>
