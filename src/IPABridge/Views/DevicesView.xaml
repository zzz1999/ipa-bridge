<UserControl x:Class="IPABridge.Views.DevicesView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <ScrollViewer VerticalScrollBarVisibility="Auto">
    <StackPanel Margin="0,0,8,18">
      <Border Margin="0,0,0,13"
              Padding="17"
              Background="{StaticResource OrangeSoftBrush}"
              CornerRadius="20"
              Visibility="{Binding Devices.HasAppleDeviceSupport, Converter={StaticResource InverseBooleanToVisibilityConverter}}">
        <Grid>
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="38" />
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="Auto" />
          </Grid.ColumnDefinitions>
          <TextBlock VerticalAlignment="Center"
                     FontFamily="{StaticResource SymbolFont}"
                     FontSize="20"
                     Foreground="{StaticResource OrangeBrush}"
                     Text="&#xE7BA;" />
          <StackPanel Grid.Column="1">
            <TextBlock FontWeight="SemiBold" Text="Apple device support not ready" />
            <TextBlock Margin="0,3,12,0"
                       Style="{StaticResource CaptionTextStyle}"
                       Foreground="#895318"
                       Text="{Binding Devices.AppleDeviceSupportDetail}"
                       TextWrapping="Wrap" />
            <TextBlock Margin="0,5,12,0"
                       Style="{StaticResource CaptionTextStyle}"
                       Foreground="#895318"
                       Text="{Binding Settings.InstallationStage}"
                       Visibility="{Binding Settings.IsInstalling, Converter={StaticResource BooleanToVisibilityConverter}}" />
          </StackPanel>
          <StackPanel Grid.Column="2" Orientation="Horizontal">
            <Button Margin="0,0,8,0"
                    AutomationProperties.Name="Check Apple device support again"
                    Style="{StaticResource SecondaryButtonStyle}"
                    Command="{Binding Settings.RefreshAppleDeviceSupportCommand}"
                    ToolTip="Check Apple device support again">
              <StackPanel Orientation="Horizontal">
                <Viewbox Width="17" Height="17" Margin="0,0,8,0" IsHitTestVisible="False">
                  <Grid Width="24" Height="24">
                    <Path Data="{StaticResource RefreshIconGeometry}"
                          Style="{StaticResource RoundedButtonIconStyle}"
                          StrokeThickness="3.1" />
                  </Grid>
                </Viewbox>
                <TextBlock VerticalAlignment="Center"
                           FontWeight="SemiBold"
                           Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                           Text="Check again" />
              </StackPanel>
            </Button>
            <Button Style="{StaticResource PrimaryButtonStyle}"
                    Command="{Binding Settings.InstallAppleDevicesCommand}"
                    Content="Install Apple Devices" />
          </StackPanel>
        </Grid>
      </Border>

      <Border Margin="0,0,0,13"
              Padding="17"
              Background="{StaticResource AccentSoftBrush}"
              CornerRadius="20"
              Visibility="{Binding Devices.AreDeviceToolsAvailable, Converter={StaticResource InverseBooleanToVisibilityConverter}}">
        <Grid>
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="38" />
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="Auto" />
          </Grid.ColumnDefinitions>
          <TextBlock VerticalAlignment="Center"
                     FontFamily="{StaticResource SymbolFont}"
                     FontSize="20"
                     Foreground="{StaticResource AccentBrush}"
                     Text="&#xE896;" />
          <StackPanel Grid.Column="1">
            <TextBlock FontWeight="SemiBold" Text="iOS device tools required" />
            <TextBlock Margin="0,3,12,0"
                       Style="{StaticResource CaptionTextStyle}"
                       Text="Download the pinned release and verify its SHA-256, or select a libimobiledevice folder in Settings."
                       TextWrapping="Wrap" />
          </StackPanel>
          <Button Grid.Column="2"
                  Style="{StaticResource PrimaryButtonStyle}"
                  Command="{Binding Settings.InstallDeviceToolsCommand}"
                  Content="Install tools" />
        </Grid>
      </Border>

      <Grid>
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="330" />
          <ColumnDefinition Width="16" />
          <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <Border Style="{StaticResource CardStyle}">
          <Grid>
            <Grid.RowDefinitions>
              <RowDefinition Height="Auto" />
              <RowDefinition Height="*" />
              <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>
            <Grid>
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
              </Grid.ColumnDefinitions>
              <StackPanel>
                <TextBlock Style="{StaticResource SectionTitleStyle}" Text="Connected Devices" />
                <TextBlock Margin="0,4,0,0"
                           Style="{StaticResource CaptionTextStyle}"
                           Text="{Binding Devices.StatusMessage}"
                           TextWrapping="Wrap" />
              </StackPanel>
              <Button Grid.Column="1"
                      AutomationProperties.Name="Refresh devices"
                      Style="{StaticResource RoundedIconButtonStyle}"
                      ToolTip="Refresh devices"
                      Command="{Binding Devices.RefreshCommand}">
                <Viewbox Width="22" Height="22" IsHitTestVisible="False">
                  <Grid Width="24" Height="24">
                    <Path Data="{StaticResource RefreshIconGeometry}"
                          Style="{StaticResource RoundedButtonIconStyle}" />
                  </Grid>
                </Viewbox>
              </Button>
            </Grid>

            <ListBox Grid.Row="1"
                     Margin="0,15,0,12"
                     IsEnabled="{Binding Devices.IsInstalling, Converter={StaticResource InverseBooleanConverter}}"
                     ItemsSource="{Binding Devices.Items}"
                     SelectedItem="{Binding Devices.SelectedDevice}">
              <ListBox.ItemTemplate>
                <DataTemplate>
                  <Grid>
                    <Grid.ColumnDefinitions>
                      <ColumnDefinition Width="50" />
                      <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <Border Width="42"
                            Height="52"
                            BorderBrush="#9CB6D9"
                            BorderThickness="3"
                            CornerRadius="11">
                      <Grid>
                        <Border Width="15"
                                Height="4"
                                Margin="0,4,0,0"
                                HorizontalAlignment="Center"
                                VerticalAlignment="Top"
                                Background="#9CB6D9"
                                CornerRadius="2" />
                        <TextBlock HorizontalAlignment="Center"
                                   VerticalAlignment="Center"
                                   FontFamily="{StaticResource SymbolFont}"
                                   FontSize="14"
                                   Foreground="{StaticResource AccentBrush}"
                                   Text="&#xE8EA;" />
                      </Grid>
                    </Border>
                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                      <TextBlock FontSize="14"
                                 FontWeight="SemiBold"
                                 Text="{Binding Name}"
                                 TextTrimming="CharacterEllipsis" />
                      <TextBlock Margin="0,3,0,0"
                                 Style="{StaticResource CaptionTextStyle}"
                                 Text="{Binding ProductVersion, StringFormat=iOS {0}}" />
                      <StackPanel Margin="0,5,0,0" Orientation="Horizontal">
                        <Ellipse Width="6"
                                 Height="6"
                                 Margin="0,0,6,0"
                                 VerticalAlignment="Center"
                                 Fill="{StaticResource GreenBrush}" />
                        <TextBlock Style="{StaticResource CaptionTextStyle}" Text="{Binding PairingLabel}" />
                      </StackPanel>
                    </StackPanel>
                  </Grid>
                </DataTemplate>
              </ListBox.ItemTemplate>
            </ListBox>

            <Border Grid.Row="2"
                    Padding="14"
                    Background="#EEF3FA"
                    CornerRadius="17"
                    Visibility="{Binding Devices.SelectedDevice, Converter={StaticResource NullToVisibilityConverter}}">
              <Grid>
                <Grid.ColumnDefinitions>
                  <ColumnDefinition Width="*" />
                  <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <StackPanel>
                  <TextBlock Style="{StaticResource CaptionTextStyle}" Text="{Binding Devices.SelectedDevice.ProductType}" />
                  <TextBlock Margin="0,3,8,0"
                             FontSize="11"
                             Foreground="{StaticResource TextSecondaryBrush}"
                             Text="{Binding Devices.SelectedDevice.ShortUdid}" />
                </StackPanel>
                <Button Grid.Column="1"
                        Style="{StaticResource SecondaryButtonStyle}"
                        Command="{Binding Devices.PairCommand}"
                        Content="Trust / Pair" />
              </Grid>
            </Border>
          </Grid>
        </Border>

        <Border Grid.Column="2" Style="{StaticResource CardStyle}">
          <StackPanel>
            <Grid>
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
              </Grid.ColumnDefinitions>
              <StackPanel>
                <TextBlock Style="{StaticResource SectionTitleStyle}" Text="Install IPA" />
                <TextBlock Margin="0,4,0,0"
                           Style="{StaticResource BodyTextStyle}"
                           Text="Choose a file and target device. The iOS installation service determines the result."
                           TextWrapping="Wrap" />
              </StackPanel>
              <Border Grid.Column="1"
                      Padding="13,7"
                      VerticalAlignment="Top"
                      Background="{StaticResource SurfaceMutedBrush}"
                      CornerRadius="14">
                <TextBlock Style="{StaticResource CaptionTextStyle}"
                           Text="{Binding Devices.DeviceToolsLabel}" />
              </Border>
            </Grid>

            <TextBlock Margin="2,22,0,7" Style="{StaticResource CaptionTextStyle}" Text="IPA file" />
            <Grid>
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="9" />
                <ColumnDefinition Width="Auto" />
              </Grid.ColumnDefinitions>
              <TextBox IsReadOnly="True"
                       Text="{Binding Devices.SelectedIpaPath, Mode=OneWay}" />
               <Button Grid.Column="2"
                       IsEnabled="{Binding Devices.IsInstalling, Converter={StaticResource InverseBooleanConverter}}"
                       Style="{StaticResource SecondaryButtonStyle}"
                      Click="ChooseIpa_OnClick"
                      Content="Browse…" />
            </Grid>

            <TextBlock Margin="2,19,0,7" Style="{StaticResource CaptionTextStyle}" Text="Target device" />
            <Border Padding="15"
                    Background="#F2F5F9"
                    BorderBrush="{StaticResource DividerBrush}"
                    BorderThickness="1.5"
                    CornerRadius="17">
              <Grid>
                <Grid.ColumnDefinitions>
                  <ColumnDefinition Width="*" />
                  <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <StackPanel>
                  <TextBlock FontSize="14"
                             FontWeight="SemiBold"
                             Text="{Binding Devices.SelectedDevice.Name, TargetNullValue='No device selected'}" />
                  <TextBlock Margin="0,3,0,0"
                             Style="{StaticResource CaptionTextStyle}"
                             Text="{Binding Devices.SelectedDevice.ConnectionType, TargetNullValue='Connect a device to choose a target'}"
                             TextWrapping="Wrap" />
                </StackPanel>
                <Viewbox Grid.Column="1"
                         Width="22"
                         Height="22"
                         Margin="12,0,0,0"
                         VerticalAlignment="Center">
                  <Path Data="M7,2 H17 A2,2 0 0 1 19,4 V20 A2,2 0 0 1 17,22 H7 A2,2 0 0 1 5,20 V4 A2,2 0 0 1 7,2 Z M10,5 H14 M11,19 H13"
                        Fill="Transparent"
                        Stroke="{StaticResource AccentBrush}"
                        StrokeEndLineCap="Round"
                        StrokeLineJoin="Round"
                        StrokeStartLineCap="Round"
                        StrokeThickness="2.25" />
                </Viewbox>
              </Grid>
            </Border>

            <StackPanel Margin="0,22,0,0"
                        Visibility="{Binding Devices.IsInstalling, Converter={StaticResource BooleanToVisibilityConverter}}">
              <Grid Margin="1,0,1,7">
                <TextBlock Style="{StaticResource CaptionTextStyle}" Text="Installation progress" />
                <TextBlock HorizontalAlignment="Right"
                           Style="{StaticResource CaptionTextStyle}"
                           Text="{Binding Devices.InstallationProgress, StringFormat={}{0:P0}}" />
              </Grid>
              <ProgressBar Value="{Binding Devices.InstallationProgress, Mode=OneWay}" Maximum="1" />
              <Border Margin="0,12,0,0"
                      Padding="12"
                      Background="#182033"
                      CornerRadius="14">
                <TextBlock MaxHeight="92"
                           FontFamily="Cascadia Mono, Consolas"
                           FontSize="11"
                           FontWeight="Medium"
                           Foreground="#D5E2F5"
                           Text="{Binding Devices.InstallationLog}"
                           TextWrapping="Wrap" />
              </Border>
            </StackPanel>

            <Grid Margin="0,22,0,0">
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="10" />
                <ColumnDefinition Width="Auto" />
              </Grid.ColumnDefinitions>
              <Button Height="48"
                      MinHeight="48"
                      Style="{StaticResource PrimaryButtonStyle}"
                      Command="{Binding Devices.InstallCommand}"
                      Content="Install on Device" />
              <Button Grid.Column="2"
                      Style="{StaticResource DangerButtonStyle}"
                      Command="{Binding Devices.CancelInstallCommand}"
                      Content="Cancel"
                      Visibility="{Binding Devices.IsInstalling, Converter={StaticResource BooleanToVisibilityConverter}}" />
            </Grid>
          </StackPanel>
        </Border>
      </Grid>

      <Border Margin="0,15,0,0"
              Padding="17"
              Background="#BFFFFFFF"
              BorderBrush="#99FFFFFF"
              BorderThickness="1.5"
              CornerRadius="20">
        <Grid>
          <Grid.ColumnDefinitions>
          <ColumnDefinition Width="36" />
            <ColumnDefinition Width="*" />
          </Grid.ColumnDefinitions>
          <TextBlock FontFamily="{StaticResource SymbolFont}"
                     FontSize="18"
                     Foreground="{StaticResource TextSecondaryBrush}"
                     Text="&#xE9D9;" />
          <TextBlock Grid.Column="1"
                     Style="{StaticResource CaptionTextStyle}"
                     Text="Unlock the device and keep its screen awake before installation. iOS will stop the installation if the signature is invalid, the account is unauthorized, the provisioning profile has expired, or a device policy rejects it; IPA Bridge will display the underlying error."
                     TextWrapping="Wrap" />
        </Grid>
      </Border>
    </StackPanel>
  </ScrollViewer>
</UserControl>
