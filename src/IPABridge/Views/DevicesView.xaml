<UserControl x:Class="IPABridge.Views.DevicesView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <ScrollViewer VerticalScrollBarVisibility="Auto">
    <StackPanel Margin="0,0,8,18">
      <Border Margin="0,0,0,13"
              Padding="15"
              Background="{StaticResource OrangeSoftBrush}"
              CornerRadius="15"
              Visibility="{Binding Devices.HasAppleDeviceSupport, Converter={StaticResource InverseBooleanToVisibilityConverter}}">
        <Grid>
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="34" />
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="Auto" />
          </Grid.ColumnDefinitions>
          <TextBlock VerticalAlignment="Center"
                     FontFamily="{StaticResource SymbolFont}"
                     FontSize="17"
                     Foreground="{StaticResource OrangeBrush}"
                     Text="&#xE7BA;" />
          <StackPanel Grid.Column="1">
            <TextBlock FontWeight="SemiBold" Text="Apple device support not ready" />
            <TextBlock Margin="0,3,12,0"
                       Style="{StaticResource CaptionTextStyle}"
                       Foreground="#895318"
                       Text="{Binding Devices.AppleDeviceSupportDetail}"
                       TextWrapping="Wrap" />
            <TextBlock Margin="0,5,12,0"
                       Style="{StaticResource CaptionTextStyle}"
                       Foreground="#895318"
                       Text="{Binding Settings.InstallationStage}"
                       Visibility="{Binding Settings.IsInstalling, Converter={StaticResource BooleanToVisibilityConverter}}" />
          </StackPanel>
          <StackPanel Grid.Column="2" Orientation="Horizontal">
            <Button Margin="0,0,8,0"
                    Style="{StaticResource SecondaryButtonStyle}"
                    Command="{Binding Settings.RefreshAppleDeviceSupportCommand}"
                    Content="Check again" />
            <Button Style="{StaticResource PrimaryButtonStyle}"
                    Command="{Binding Settings.InstallAppleDevicesCommand}"
                    Content="Install Apple Devices" />
          </StackPanel>
        </Grid>
      </Border>

      <Border Margin="0,0,0,13"
              Padding="15"
              Background="{StaticResource AccentSoftBrush}"
              CornerRadius="15"
              Visibility="{Binding Devices.AreDeviceToolsAvailable, Converter={StaticResource InverseBooleanToVisibilityConverter}}">
        <Grid>
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="34" />
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="Auto" />
          </Grid.ColumnDefinitions>
          <TextBlock VerticalAlignment="Center"
                     FontFamily="{StaticResource SymbolFont}"
                     FontSize="17"
                     Foreground="{StaticResource AccentBrush}"
                     Text="&#xE896;" />
          <StackPanel Grid.Column="1">
            <TextBlock FontWeight="SemiBold" Text="iOS device tools required" />
            <TextBlock Margin="0,3,12,0"
                       Style="{StaticResource CaptionTextStyle}"
                       Text="Download the pinned release and verify its SHA-256, or select a libimobiledevice folder in Settings."
                       TextWrapping="Wrap" />
          </StackPanel>
          <Button Grid.Column="2"
                  Style="{StaticResource PrimaryButtonStyle}"
                  Command="{Binding Settings.InstallDeviceToolsCommand}"
                  Content="Install tools" />
        </Grid>
      </Border>

      <Grid>
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="330" />
          <ColumnDefinition Width="16" />
          <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <Border Style="{StaticResource CardStyle}">
          <Grid>
            <Grid.RowDefinitions>
              <RowDefinition Height="Auto" />
              <RowDefinition Height="*" />
              <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>
            <Grid>
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
              </Grid.ColumnDefinitions>
              <StackPanel>
                <TextBlock Style="{StaticResource SectionTitleStyle}" Text="Connected Devices" />
                <TextBlock Margin="0,4,0,0"
                           Style="{StaticResource CaptionTextStyle}"
                           Text="{Binding Devices.StatusMessage}"
                           TextWrapping="Wrap" />
              </StackPanel>
              <Button Grid.Column="1"
                      AutomationProperties.Name="Refresh devices"
                      Width="40"
                      Height="40"
                      Padding="0"
                      Style="{StaticResource GhostButtonStyle}"
                      FontFamily="{StaticResource AppFont}"
                      FontSize="18"
                      Content="↻"
                      Command="{Binding Devices.RefreshCommand}" />
            </Grid>

            <ListBox Grid.Row="1"
                     Margin="0,15,0,12"
                     IsEnabled="{Binding Devices.IsInstalling, Converter={StaticResource InverseBooleanConverter}}"
                     ItemsSource="{Binding Devices.Items}"
                     SelectedItem="{Binding Devices.SelectedDevice}">
              <ListBox.ItemTemplate>
                <DataTemplate>
                  <Grid>
                    <Grid.ColumnDefinitions>
                      <ColumnDefinition Width="50" />
                      <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <Border Width="39"
                            Height="48"
                            BorderBrush="#9CB6D9"
                            BorderThickness="2"
                            CornerRadius="9">
                      <Grid>
                        <Border Width="15"
                                Height="3"
                                Margin="0,4,0,0"
                                HorizontalAlignment="Center"
                                VerticalAlignment="Top"
                                Background="#9CB6D9"
                                CornerRadius="2" />
                        <TextBlock HorizontalAlignment="Center"
                                   VerticalAlignment="Center"
                                   FontFamily="{StaticResource SymbolFont}"
                                   FontSize="14"
                                   Foreground="{StaticResource AccentBrush}"
                                   Text="&#xE8EA;" />
                      </Grid>
                    </Border>
                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                      <TextBlock FontSize="14"
                                 FontWeight="SemiBold"
                                 Text="{Binding Name}"
                                 TextTrimming="CharacterEllipsis" />
                      <TextBlock Margin="0,3,0,0"
                                 Style="{StaticResource CaptionTextStyle}"
                                 Text="{Binding ProductVersion, StringFormat=iOS {0}}" />
                      <StackPanel Margin="0,5,0,0" Orientation="Horizontal">
                        <Ellipse Width="6"
                                 Height="6"
                                 Margin="0,0,6,0"
                                 VerticalAlignment="Center"
                                 Fill="{StaticResource GreenBrush}" />
                        <TextBlock Style="{StaticResource CaptionTextStyle}" Text="{Binding PairingLabel}" />
                      </StackPanel>
                    </StackPanel>
                  </Grid>
                </DataTemplate>
              </ListBox.ItemTemplate>
            </ListBox>

            <Border Grid.Row="2"
                    Padding="12"
                    Background="#EEF3FA"
                    CornerRadius="13"
                    Visibility="{Binding Devices.SelectedDevice, Converter={StaticResource NullToVisibilityConverter}}">
              <Grid>
                <Grid.ColumnDefinitions>
                  <ColumnDefinition Width="*" />
                  <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <StackPanel>
                  <TextBlock Style="{StaticResource CaptionTextStyle}" Text="{Binding Devices.SelectedDevice.ProductType}" />
                  <TextBlock Margin="0,3,8,0"
                             FontSize="11"
                             Foreground="{StaticResource TextSecondaryBrush}"
                             Text="{Binding Devices.SelectedDevice.ShortUdid}" />
                </StackPanel>
                <Button Grid.Column="1"
                        Style="{StaticResource SecondaryButtonStyle}"
                        Command="{Binding Devices.PairCommand}"
                        Content="Trust / Pair" />
              </Grid>
            </Border>
          </Grid>
        </Border>

        <Border Grid.Column="2" Style="{StaticResource CardStyle}">
          <StackPanel>
            <Grid>
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
              </Grid.ColumnDefinitions>
              <StackPanel>
                <TextBlock Style="{StaticResource SectionTitleStyle}" Text="Install IPA" />
                <TextBlock Margin="0,4,0,0"
                           Style="{StaticResource BodyTextStyle}"
                           Text="Choose a file and target device. The iOS installation service determines the result." />
              </StackPanel>
              <Border Grid.Column="1"
                      Padding="11,5"
                      VerticalAlignment="Top"
                      Background="{StaticResource SurfaceMutedBrush}"
                      CornerRadius="10">
                <TextBlock Style="{StaticResource CaptionTextStyle}"
                           Text="{Binding Devices.DeviceToolsLabel}" />
              </Border>
            </Grid>

            <TextBlock Margin="2,22,0,7" Style="{StaticResource CaptionTextStyle}" Text="IPA file" />
            <Grid>
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="9" />
                <ColumnDefinition Width="Auto" />
              </Grid.ColumnDefinitions>
              <TextBox IsReadOnly="True"
                       Text="{Binding Devices.SelectedIpaPath}" />
               <Button Grid.Column="2"
                       IsEnabled="{Binding Devices.IsInstalling, Converter={StaticResource InverseBooleanConverter}}"
                       Style="{StaticResource SecondaryButtonStyle}"
                      Click="ChooseIpa_OnClick"
                      Content="Browse…" />
            </Grid>

            <TextBlock Margin="2,19,0,7" Style="{StaticResource CaptionTextStyle}" Text="Target device" />
            <Border Padding="14"
                    Background="#F2F5F9"
                    BorderBrush="{StaticResource DividerBrush}"
                    BorderThickness="1"
                    CornerRadius="13">
              <Grid>
                <Grid.ColumnDefinitions>
                  <ColumnDefinition Width="*" />
                  <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <StackPanel>
                  <TextBlock FontSize="14"
                             FontWeight="SemiBold"
                             Text="{Binding Devices.SelectedDevice.Name, TargetNullValue='No device selected'}" />
                  <TextBlock Margin="0,3,0,0"
                             Style="{StaticResource CaptionTextStyle}"
                             Text="{Binding Devices.SelectedDevice.ConnectionType, TargetNullValue='Connect a device to choose a target'}" />
                </StackPanel>
                <TextBlock Grid.Column="1"
                           VerticalAlignment="Center"
                           FontFamily="{StaticResource SymbolFont}"
                           FontSize="18"
                           Foreground="{StaticResource AccentBrush}"
                           Text="&#xE8B2;" />
              </Grid>
            </Border>

            <StackPanel Margin="0,22,0,0"
                        Visibility="{Binding Devices.IsInstalling, Converter={StaticResource BooleanToVisibilityConverter}}">
              <Grid Margin="1,0,1,7">
                <TextBlock Style="{StaticResource CaptionTextStyle}" Text="Installation progress" />
                <TextBlock HorizontalAlignment="Right"
                           Style="{StaticResource CaptionTextStyle}"
                           Text="{Binding Devices.InstallationProgress, StringFormat={}{0:P0}}" />
              </Grid>
              <ProgressBar Value="{Binding Devices.InstallationProgress}" Maximum="1" />
              <Border Margin="0,12,0,0"
                      Padding="10"
                      Background="#182033"
                      CornerRadius="10">
                <TextBlock MaxHeight="92"
                           FontFamily="Cascadia Mono, Consolas"
                           FontSize="10"
                           Foreground="#D5E2F5"
                           Text="{Binding Devices.InstallationLog}"
                           TextWrapping="Wrap" />
              </Border>
            </StackPanel>

            <Grid Margin="0,22,0,0">
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="10" />
                <ColumnDefinition Width="Auto" />
              </Grid.ColumnDefinitions>
              <Button Height="44"
                      Style="{StaticResource PrimaryButtonStyle}"
                      Command="{Binding Devices.InstallCommand}"
                      Content="Install on Device" />
              <Button Grid.Column="2"
                      Style="{StaticResource DangerButtonStyle}"
                      Command="{Binding Devices.CancelInstallCommand}"
                      Content="Cancel"
                      Visibility="{Binding Devices.IsInstalling, Converter={StaticResource BooleanToVisibilityConverter}}" />
            </Grid>
          </StackPanel>
        </Border>
      </Grid>

      <Border Margin="0,15,0,0"
              Padding="15"
              Background="#BFFFFFFF"
              BorderBrush="#99FFFFFF"
              BorderThickness="1"
              CornerRadius="16">
        <Grid>
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="32" />
            <ColumnDefinition Width="*" />
          </Grid.ColumnDefinitions>
          <TextBlock FontFamily="{StaticResource SymbolFont}"
                     FontSize="16"
                     Foreground="{StaticResource TextSecondaryBrush}"
                     Text="&#xE9D9;" />
          <TextBlock Grid.Column="1"
                     Style="{StaticResource CaptionTextStyle}"
                     Text="Unlock the device and keep its screen awake before installation. iOS will stop the installation if the signature is invalid, the account is unauthorized, the provisioning profile has expired, or a device policy rejects it; IPA Bridge will display the underlying error."
                     TextWrapping="Wrap" />
        </Grid>
      </Border>
    </StackPanel>
  </ScrollViewer>
</UserControl>
