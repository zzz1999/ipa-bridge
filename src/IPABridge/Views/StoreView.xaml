<UserControl x:Class="IPABridge.Views.StoreView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <Grid Margin="0,0,8,14">
    <Grid.ColumnDefinitions>
      <ColumnDefinition Width="*" />
      <ColumnDefinition Width="18" />
      <ColumnDefinition Width="330" />
    </Grid.ColumnDefinitions>

    <Border Style="{StaticResource CardStyle}">
      <Grid>
        <Grid.RowDefinitions>
          <RowDefinition Height="Auto" />
          <RowDefinition Height="Auto" />
          <RowDefinition Height="*" />
          <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <Grid>
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="10" />
            <ColumnDefinition Width="Auto" />
          </Grid.ColumnDefinitions>
          <TextBox x:Name="StoreSearchBox"
                   Height="48"
                   Text="{Binding Store.SearchQuery, UpdateSourceTrigger=PropertyChanged}">
            <TextBox.InputBindings>
              <KeyBinding Key="Enter" Command="{Binding Store.SearchCommand}" />
            </TextBox.InputBindings>
          </TextBox>
          <Button Grid.Column="2"
                  MinWidth="92"
                  Style="{StaticResource PrimaryButtonStyle}"
                  Command="{Binding Store.SearchCommand}"
                  Content="Search Apps" />
        </Grid>

        <Grid Grid.Row="1" Margin="1,12,1,12">
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="Auto" />
          </Grid.ColumnDefinitions>
          <TextBlock Style="{StaticResource BodyTextStyle}"
                     Text="{Binding Store.StatusMessage}"
                     TextTrimming="CharacterEllipsis" />
          <StackPanel Grid.Column="1"
                      Visibility="{Binding Store.IsBusy, Converter={StaticResource BooleanToVisibilityConverter}}"
                      Orientation="Horizontal">
            <TextBlock Margin="0,0,8,0"
                       Style="{StaticResource CaptionTextStyle}"
                       Text="{Binding Store.OperationTitle}" />
            <ProgressBar Width="90" IsIndeterminate="True" />
          </StackPanel>
        </Grid>

        <ListBox Grid.Row="2"
                 ItemsSource="{Binding Store.SearchResults}"
                 SelectedItem="{Binding Store.SelectedApp}">
          <ListBox.ItemTemplate>
            <DataTemplate>
              <Grid>
                <Grid.ColumnDefinitions>
                  <ColumnDefinition Width="58" />
                  <ColumnDefinition Width="*" />
                  <ColumnDefinition Width="76" />
                </Grid.ColumnDefinitions>
                <Border Width="48"
                        Height="48"
                        Background="{StaticResource HeroGradientBrush}"
                        CornerRadius="15">
                  <TextBlock HorizontalAlignment="Center"
                             VerticalAlignment="Center"
                             FontSize="20"
                             FontWeight="SemiBold"
                             Foreground="White"
                             Text="{Binding Monogram}" />
                </Border>
                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                  <TextBlock FontSize="14"
                             FontWeight="SemiBold"
                             Text="{Binding Name}"
                             TextTrimming="CharacterEllipsis" />
                  <TextBlock Margin="0,3,8,0"
                             Style="{StaticResource CaptionTextStyle}"
                             Text="{Binding BundleIdentifier}"
                             TextTrimming="CharacterEllipsis" />
                </StackPanel>
                <StackPanel Grid.Column="2"
                            HorizontalAlignment="Right"
                            VerticalAlignment="Center">
                  <TextBlock HorizontalAlignment="Right"
                             FontSize="12"
                             FontWeight="SemiBold"
                             Foreground="{StaticResource AccentBrush}"
                             Text="{Binding PriceLabel}" />
                  <TextBlock Margin="0,3,0,0"
                             HorizontalAlignment="Right"
                             Style="{StaticResource CaptionTextStyle}"
                             Text="{Binding Version}" />
                </StackPanel>
              </Grid>
            </DataTemplate>
          </ListBox.ItemTemplate>
        </ListBox>

        <Border Grid.Row="3"
                Margin="0,12,0,0"
                Padding="16"
                Background="#EEF3FA"
                CornerRadius="18"
                Visibility="{Binding Store.SelectedApp, Converter={StaticResource NullToVisibilityConverter}}">
          <Grid>
            <Grid.RowDefinitions>
              <RowDefinition Height="Auto" />
              <RowDefinition Height="12" />
              <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <Grid>
              <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="10" />
                <RowDefinition Height="Auto" />
              </Grid.RowDefinitions>
              <StackPanel VerticalAlignment="Center">
                <TextBlock FontSize="14"
                           FontWeight="SemiBold"
                           Text="{Binding Store.SelectedApp.Name}"
                           TextTrimming="CharacterEllipsis" />
                <TextBlock Margin="0,3,0,0"
                           Style="{StaticResource CaptionTextStyle}"
                           Text="{Binding Store.SelectedAccountSummary}"
                           TextTrimming="CharacterEllipsis" />
              </StackPanel>
              <StackPanel Grid.Row="2"
                          HorizontalAlignment="Right"
                          Orientation="Horizontal">
                <Button Margin="0,0,8,0"
                        Style="{StaticResource SecondaryButtonStyle}"
                        Command="{Binding Store.LoadVersionsCommand}"
                        Content="Load Version History" />
                <Button Style="{StaticResource PrimaryButtonStyle}"
                        Command="{Binding Store.DownloadCommand}"
                        Content="Acquire &amp; Download" />
              </StackPanel>
            </Grid>

            <Grid Grid.Row="2">
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="76" />
                <ColumnDefinition Width="*" />
              </Grid.ColumnDefinitions>
              <TextBlock VerticalAlignment="Center"
                         Style="{StaticResource CaptionTextStyle}"
                         Text="Download version" />
              <ComboBox Grid.Column="1"
                        MaxDropDownHeight="360"
                        ItemsSource="{Binding Store.Versions}"
                        SelectedItem="{Binding Store.SelectedVersion}"
                        IsEnabled="{Binding Store.IsBusy, Converter={StaticResource InverseBooleanConverter}}"
                        ToolTip="Downloads the latest version when no historical version is selected">
                <ComboBox.ItemTemplate>
                  <DataTemplate>
                    <Grid Margin="0,2">
                      <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                      </Grid.RowDefinitions>
                      <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                      </Grid.ColumnDefinitions>
                      <TextBlock FontWeight="SemiBold"
                                 Foreground="{StaticResource TextPrimaryBrush}"
                                 Text="{Binding VersionLabel}"
                                 TextTrimming="CharacterEllipsis" />
                      <TextBlock Grid.Column="1"
                                 Margin="12,0,0,0"
                                 Style="{StaticResource CaptionTextStyle}"
                                 Text="{Binding ReleaseDateLabel}"
                                 TextTrimming="CharacterEllipsis" />
                      <TextBlock Grid.Row="1"
                                 Grid.ColumnSpan="2"
                                 Margin="0,3,0,0"
                                 Style="{StaticResource CaptionTextStyle}"
                                 Text="{Binding IdentifierLabel}"
                                 TextTrimming="CharacterEllipsis" />
                    </Grid>
                  </DataTemplate>
                </ComboBox.ItemTemplate>
              </ComboBox>
            </Grid>
          </Grid>
        </Border>
      </Grid>
    </Border>

    <Border Grid.Column="2" Style="{StaticResource CardStyle}">
      <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel>
          <Border Width="52"
                  Height="52"
                  Margin="0,0,0,15"
                  HorizontalAlignment="Left"
                  Background="{StaticResource AccentSoftBrush}"
                  CornerRadius="18">
            <TextBlock HorizontalAlignment="Center"
                       VerticalAlignment="Center"
                       FontFamily="{StaticResource SymbolFont}"
                       FontSize="22"
                       Foreground="{StaticResource AccentBrush}"
                       Text="&#xE77B;" />
          </Border>
          <TextBlock Style="{StaticResource SectionTitleStyle}" Text="Apple Accounts" />
          <TextBlock Margin="0,5,0,15"
                     Style="{StaticResource BodyTextStyle}"
                     Text="Choose an account before searching or acquiring an app. Each account has an isolated local ipatool session and uses the App Store region assigned by Apple."
                     TextWrapping="Wrap" />

          <StackPanel x:Name="AppleAccountSelectionSection"
                      Visibility="{Binding Store.IsAccountSelectionSectionVisible, Converter={StaticResource BooleanToVisibilityConverter}}">
            <TextBlock Margin="2,0,0,6"
                       Style="{StaticResource CaptionTextStyle}"
                       Text="Account for search and purchase" />
            <Grid x:Name="AppleAccountSelectorRow"
                  Visibility="{Binding Store.HasAccounts, Converter={StaticResource BooleanToVisibilityConverter}}">
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="10" />
                <ColumnDefinition Width="48" />
              </Grid.ColumnDefinitions>
              <ComboBox x:Name="AppleAccountSelector"
                        AutomationProperties.HelpText="Selects the isolated Apple Account used for App Store search, license acquisition, and download"
                        AutomationProperties.Name="Apple Account for App Store operations"
                        FocusVisualStyle="{x:Null}"
                        IsEnabled="{Binding Store.CanSelectAccount}"
                        IsTextSearchEnabled="True"
                        ItemsSource="{Binding Store.Accounts}"
                        SelectedItem="{Binding Store.SelectedAccount, Mode=OneWay}"
                        SelectionChanged="AppleAccountSelector_OnSelectionChanged"
                        TextSearch.TextPath="Email">
                <ComboBox.ItemContainerStyle>
                  <Style BasedOn="{StaticResource {x:Type ComboBoxItem}}" TargetType="ComboBoxItem">
                    <Setter Property="MinHeight" Value="44" />
                  </Style>
                </ComboBox.ItemContainerStyle>
                <ComboBox.ItemTemplate>
                  <DataTemplate>
                    <TextBlock Text="{Binding Email}"
                               TextTrimming="CharacterEllipsis"
                               ToolTip="{Binding Email}" />
                  </DataTemplate>
                </ComboBox.ItemTemplate>
              </ComboBox>
              <Button x:Name="AddAppleAccountButton"
                      Grid.Column="2"
                      Width="48"
                      Height="48"
                      AutomationProperties.Name="Add Apple Account"
                      Command="{Binding Store.AddAccountCommand}"
                      Style="{StaticResource SecondaryButtonStyle}"
                      ToolTip="Add Apple Account">
                <Canvas Width="18" Height="18">
                  <Rectangle Width="18"
                             Height="3"
                             Canvas.Top="7.5"
                             Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                             RadiusX="1.5"
                             RadiusY="1.5" />
                  <Rectangle Width="3"
                             Height="18"
                             Canvas.Left="7.5"
                             Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                             RadiusX="1.5"
                             RadiusY="1.5" />
                </Canvas>
              </Button>
            </Grid>

            <Button x:Name="AddFirstAppleAccountButton"
                    MinHeight="72"
                    Padding="14,10"
                    HorizontalContentAlignment="Stretch"
                    AutomationProperties.HelpText="Creates the first isolated local Apple Account profile"
                    AutomationProperties.Name="Add Apple Account"
                    Command="{Binding Store.AddAccountCommand}"
                    Style="{StaticResource PrivacyCardButtonStyle}"
                    Visibility="{Binding Store.IsEmptyAccountPromptVisible, Converter={StaticResource BooleanToVisibilityConverter}}">
              <Grid>
                <Grid.ColumnDefinitions>
                  <ColumnDefinition Width="36" />
                  <ColumnDefinition Width="12" />
                  <ColumnDefinition Width="*" />
                  <ColumnDefinition Width="10" />
                  <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <Border Width="36"
                        Height="36"
                        Background="{StaticResource AccentSoftBrush}"
                        CornerRadius="12">
                  <Canvas Width="18"
                          Height="18"
                          HorizontalAlignment="Center"
                          VerticalAlignment="Center">
                    <Rectangle Width="18"
                               Height="3"
                               Canvas.Top="7.5"
                               Fill="{StaticResource AccentBrush}"
                               RadiusX="1.5"
                               RadiusY="1.5" />
                    <Rectangle Width="3"
                               Height="18"
                               Canvas.Left="7.5"
                               Fill="{StaticResource AccentBrush}"
                               RadiusX="1.5"
                               RadiusY="1.5" />
                  </Canvas>
                </Border>
                <StackPanel Grid.Column="2" VerticalAlignment="Center">
                  <TextBlock FontSize="13"
                             FontWeight="SemiBold"
                             Text="Add Apple Account" />
                  <TextBlock Margin="0,2,0,0"
                             Style="{StaticResource CaptionTextStyle}"
                             Text="Create your first local profile"
                             TextTrimming="CharacterEllipsis" />
                </StackPanel>
                <Path Grid.Column="4"
                      Width="8"
                      Height="14"
                      VerticalAlignment="Center"
                      Data="M 1,1 L 7,7 L 1,13"
                      Stretch="None"
                      Stroke="{StaticResource TextTertiaryBrush}"
                      StrokeEndLineCap="Round"
                      StrokeLineJoin="Round"
                      StrokeStartLineCap="Round"
                      StrokeThickness="2.2" />
              </Grid>
            </Button>
          </StackPanel>

          <Border Margin="0,12,0,0"
                  Padding="14"
                  Background="{StaticResource AccentSoftBrush}"
                  CornerRadius="16">
            <StackPanel>
              <TextBlock FontSize="12"
                         FontWeight="SemiBold"
                         Foreground="{StaticResource AccentBrush}"
                         Text="Account storefront" />
              <TextBlock Margin="0,3,0,0"
                         Style="{StaticResource CaptionTextStyle}"
                         Text="{Binding Store.StorefrontSummary}"
                         TextWrapping="Wrap" />
            </StackPanel>
          </Border>

          <Button Margin="0,10,0,0"
                  HorizontalAlignment="Left"
                  AutomationProperties.Name="Remove selected Apple Account from this PC"
                  Command="{Binding Store.RequestRemoveAccountCommand}"
                  Content="Remove from this PC"
                  Style="{StaticResource GhostButtonStyle}"
                  Visibility="{Binding Store.SelectedAccount, Converter={StaticResource NullToVisibilityConverter}}" />

          <Border Margin="0,10,0,0"
                  Padding="14"
                  Background="{StaticResource OrangeSoftBrush}"
                  CornerRadius="16"
                  Visibility="{Binding Store.IsRemoveConfirmationVisible, Converter={StaticResource BooleanToVisibilityConverter}}">
            <StackPanel>
              <TextBlock Style="{StaticResource CaptionTextStyle}"
                         Foreground="#9A5A12"
                         Text="Remove this profile and its local ipatool account session from this PC?"
                         TextWrapping="Wrap" />
              <Grid Margin="0,10,0,0">
                <Grid.ColumnDefinitions>
                  <ColumnDefinition Width="*" />
                  <ColumnDefinition Width="8" />
                  <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <Button Command="{Binding Store.CancelRemoveAccountCommand}"
                        Content="Cancel"
                        Style="{StaticResource SecondaryButtonStyle}" />
                <Button Grid.Column="2"
                        Command="{Binding Store.ConfirmRemoveAccountCommand}"
                        Content="Remove"
                        Style="{StaticResource SecondaryButtonStyle}" />
              </Grid>
            </StackPanel>
          </Border>

          <StackPanel x:Name="AccountFormPanel"
                      Visibility="{Binding Store.IsAccountFormVisible, Converter={StaticResource BooleanToVisibilityConverter}}">
            <TextBlock Margin="0,18,0,0"
                       Style="{StaticResource SectionTitleStyle}"
                       Text="{Binding Store.AccountFormTitle}" />
            <TextBlock Margin="2,12,0,6" Style="{StaticResource CaptionTextStyle}" Text="Apple Account email" />
            <TextBox x:Name="AppleAccountEmailBox"
                     IsReadOnly="{Binding Store.IsAccountEmailReadOnly}"
                     Text="{Binding Store.Email, UpdateSourceTrigger=PropertyChanged}" />

            <TextBlock Margin="2,13,0,6" Style="{StaticResource CaptionTextStyle}" Text="Apple Account password" />
            <PasswordBox x:Name="ApplePasswordBox"
                         PasswordChanged="ApplePasswordBox_OnPasswordChanged" />

            <StackPanel Visibility="{Binding Store.RequiresTwoFactor, Converter={StaticResource BooleanToVisibilityConverter}}">
              <TextBlock Margin="2,13,0,6"
                         Style="{StaticResource CaptionTextStyle}"
                         Foreground="{StaticResource OrangeBrush}"
                         Text="Two-factor authentication code" />
              <PasswordBox x:Name="TwoFactorCodeBox"
                           PasswordChar="●"
                           PasswordChanged="TwoFactorCodeBox_OnPasswordChanged" />
            </StackPanel>

            <TextBlock Margin="2,13,0,6" Style="{StaticResource CaptionTextStyle}" Text="Local vault passphrase" />
            <PasswordBox x:Name="VaultPassphraseBox"
                         PasswordChanged="VaultPassphraseBox_OnPasswordChanged" />
            <TextBlock Margin="2,6,0,0"
                       Style="{StaticResource CaptionTextStyle}"
                       Text="This differs from your Apple password and protects the sign-in saved locally by ipatool."
                       TextWrapping="Wrap" />

            <Grid Margin="0,18,0,0">
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="8" />
                <ColumnDefinition Width="*" />
              </Grid.ColumnDefinitions>
              <Button Padding="16,11"
                      Style="{StaticResource SecondaryButtonStyle}"
                      Command="{Binding Store.CheckAccountCommand}"
                      Content="Check Session" />
              <Button Grid.Column="2"
                      Padding="16,11"
                      Style="{StaticResource PrimaryButtonStyle}"
                      Command="{Binding Store.LoginCommand}"
                      Content="{Binding Store.AccountActionLabel}" />
            </Grid>

            <Button Margin="0,9,0,0"
                    Command="{Binding Store.CancelAccountEditCommand}"
                    Content="Cancel Adding Account"
                    Style="{StaticResource GhostButtonStyle}"
                    Visibility="{Binding Store.IsAddingAccount, Converter={StaticResource BooleanToVisibilityConverter}}" />
          </StackPanel>

          <Border Margin="0,18,0,0"
                  Padding="14"
                  Background="{StaticResource GreenSoftBrush}"
                  CornerRadius="17"
                  Visibility="{Binding Store.IsLoggedIn, Converter={StaticResource BooleanToVisibilityConverter}}">
            <StackPanel Orientation="Horizontal">
              <TextBlock Margin="0,0,8,0"
                         FontFamily="{StaticResource SymbolFont}"
                         Foreground="{StaticResource GreenBrush}"
                         Text="&#xE73E;" />
              <TextBlock AutomationProperties.LiveSetting="Polite"
                         FontSize="12"
                         FontWeight="SemiBold"
                         Foreground="{StaticResource GreenBrush}"
                         Text="{Binding Store.ActiveAccountLabel}"
                         TextWrapping="Wrap" />
            </StackPanel>
          </Border>

          <Border x:Name="VerboseLoggingTip"
                  Margin="0,18,0,0"
                  Padding="14"
                  Background="{StaticResource OrangeSoftBrush}"
                  CornerRadius="17"
                  Visibility="{Binding Store.IsVerboseLoggingTipVisible, Converter={StaticResource BooleanToVisibilityConverter}}">
            <Grid>
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
              </Grid.ColumnDefinitions>
              <TextBlock Style="{StaticResource CaptionTextStyle}"
                         Foreground="#9A5A12"
                         Text="Tip: Do not enable ipatool verbose logging; upstream verbose output may include authentication fields. IPA Bridge never enables it."
                         TextWrapping="Wrap" />
              <Button x:Name="DismissVerboseLoggingTipButton"
                      Grid.Column="1"
                      Width="30"
                      Height="30"
                      MinHeight="30"
                      Margin="8,-4,-4,0"
                      Padding="0"
                      VerticalAlignment="Top"
                      AutomationProperties.Name="Dismiss verbose logging tip"
                      Background="#169A5A12"
                      Command="{Binding Store.DismissVerboseLoggingTipCommand}"
                      Foreground="#9A5A12"
                      Style="{StaticResource GhostButtonStyle}"
                      ToolTip="Dismiss tip">
                <Viewbox Width="16" Height="16" IsHitTestVisible="False">
                  <Grid Width="24" Height="24">
                    <Path Data="{StaticResource CloseIconGeometry}"
                          Style="{StaticResource RoundedButtonIconStyle}"
                          StrokeThickness="3.3" />
                  </Grid>
                </Viewbox>
              </Button>
            </Grid>
          </Border>
        </StackPanel>
      </ScrollViewer>
    </Border>
  </Grid>
</UserControl>
