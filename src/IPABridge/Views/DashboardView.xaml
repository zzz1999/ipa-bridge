<UserControl x:Class="IPABridge.Views.DashboardView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:models="clr-namespace:IPABridge.Models">
  <ScrollViewer VerticalScrollBarVisibility="Auto">
    <StackPanel Margin="0,0,8,18">
      <Border Height="218"
              Padding="30"
              Background="{StaticResource HeroGradientBrush}"
              CornerRadius="24"
              ClipToBounds="True">
        <Grid>
          <Ellipse Width="290"
                   Height="290"
                   Margin="0,-145,-80,0"
                   HorizontalAlignment="Right"
                   VerticalAlignment="Top"
                   Fill="#20FFFFFF" />
          <Ellipse Width="170"
                   Height="170"
                   Margin="0,0,90,-110"
                   HorizontalAlignment="Right"
                   VerticalAlignment="Bottom"
                   Fill="#1AFFFFFF" />
          <Grid>
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="*" />
              <ColumnDefinition Width="220" />
            </Grid.ColumnDefinitions>

            <StackPanel VerticalAlignment="Center">
              <Border Width="112"
                      Margin="0,0,0,15"
                      Padding="11,5"
                      HorizontalAlignment="Left"
                      Background="#27FFFFFF"
                      CornerRadius="11">
                <TextBlock HorizontalAlignment="Center"
                           FontSize="11"
                           FontWeight="SemiBold"
                           Foreground="White"
                           Text="WINDOWS / iOS" />
              </Border>
              <TextBlock FontSize="29"
                         FontWeight="SemiBold"
                         Foreground="White"
                         Text="Download. Connect. Install."
                         TextWrapping="Wrap" />
              <TextBlock Margin="0,8,0,21"
                         HorizontalAlignment="Left"
                         FontSize="13"
                         LineHeight="21"
                         Foreground="#E7FFFFFF"
                         Text="IPA Bridge brings the official ipatool and Windows device communication together in one clear, traceable workflow."
                         TextWrapping="Wrap" />
              <StackPanel Orientation="Horizontal">
                <Button Margin="0,0,10,0"
                        Padding="18,10"
                        Background="White"
                        Foreground="#225FC9"
                        Command="{Binding NavigateCommand}"
                        CommandParameter="{x:Static models:NavigationPage.Store}"
                        Content="Browse the App Store" />
                <Button Padding="18,10"
                        Background="#24FFFFFF"
                        Foreground="White"
                        Command="{Binding NavigateCommand}"
                        CommandParameter="{x:Static models:NavigationPage.Devices}"
                        Content="View devices" />
              </StackPanel>
            </StackPanel>

            <Grid Grid.Column="1" HorizontalAlignment="Center" VerticalAlignment="Center">
              <Border Width="132"
                      Height="176"
                      Margin="0,0,64,0"
                      Background="#21FFFFFF"
                      BorderBrush="#54FFFFFF"
                      BorderThickness="1"
                      CornerRadius="28"
                      RenderTransformOrigin="0.5,0.5">
                <Border.RenderTransform>
                  <RotateTransform Angle="-8" />
                </Border.RenderTransform>
                <Grid>
                  <Border Width="48"
                          Height="5"
                          Margin="0,10,0,0"
                          HorizontalAlignment="Center"
                          VerticalAlignment="Top"
                          Background="#50FFFFFF"
                          CornerRadius="3" />
                  <TextBlock VerticalAlignment="Center"
                             HorizontalAlignment="Center"
                             FontFamily="{StaticResource SymbolFont}"
                             FontSize="42"
                             Foreground="#CFFFFFFF"
                             Text="&#xE8EA;" />
                </Grid>
              </Border>
              <Border Width="148"
                      Height="190"
                      Margin="82,14,0,0"
                      Background="#32FFFFFF"
                      BorderBrush="#77FFFFFF"
                      BorderThickness="1"
                      CornerRadius="30"
                      RenderTransformOrigin="0.5,0.5">
                <Border.RenderTransform>
                  <RotateTransform Angle="7" />
                </Border.RenderTransform>
                <Grid>
                  <Border Width="54"
                          Height="5"
                          Margin="0,11,0,0"
                          HorizontalAlignment="Center"
                          VerticalAlignment="Top"
                          Background="#58FFFFFF"
                          CornerRadius="3" />
                  <Grid Width="70" Height="70">
                    <Ellipse Fill="#2FFFFFFF" />
                    <TextBlock HorizontalAlignment="Center"
                               VerticalAlignment="Center"
                               FontFamily="{StaticResource SymbolFont}"
                               FontSize="29"
                               Foreground="White"
                               Text="&#xE8B2;" />
                  </Grid>
                </Grid>
              </Border>
            </Grid>
          </Grid>
        </Grid>
      </Border>

      <Grid Margin="0,18,0,0">
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="*" />
          <ColumnDefinition Width="14" />
          <ColumnDefinition Width="*" />
          <ColumnDefinition Width="14" />
          <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <Border Style="{StaticResource CompactCardStyle}">
          <Grid>
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="45" />
              <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <Border Width="38" Height="38" Background="{StaticResource AccentSoftBrush}" CornerRadius="12">
              <TextBlock HorizontalAlignment="Center"
                         VerticalAlignment="Center"
                         FontFamily="{StaticResource SymbolFont}"
                         FontSize="17"
                         Foreground="{StaticResource AccentBrush}"
                         Text="&#xE896;" />
            </Border>
            <StackPanel Grid.Column="1" Margin="9,0,0,0">
              <TextBlock Style="{StaticResource CaptionTextStyle}" Text="Store component" />
              <TextBlock Margin="0,3,0,0"
                         FontSize="14"
                         FontWeight="SemiBold"
                         Text="{Binding Settings.IpatoolStatus}" />
            </StackPanel>
          </Grid>
        </Border>

        <Border Grid.Column="2" Style="{StaticResource CompactCardStyle}">
          <Grid>
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="45" />
              <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <Border Width="38" Height="38" Background="#E9E5FF" CornerRadius="12">
              <TextBlock HorizontalAlignment="Center"
                         VerticalAlignment="Center"
                         FontFamily="{StaticResource SymbolFont}"
                         FontSize="17"
                         Foreground="{StaticResource PurpleBrush}"
                         Text="&#xE8B2;" />
            </Border>
            <StackPanel Grid.Column="1" Margin="9,0,0,0">
              <TextBlock Style="{StaticResource CaptionTextStyle}" Text="Device tools" />
              <TextBlock Margin="0,3,0,0"
                         FontSize="14"
                         FontWeight="SemiBold"
                         Text="{Binding Settings.DeviceToolsStatus}" />
            </StackPanel>
          </Grid>
        </Border>

        <Border Grid.Column="4" Style="{StaticResource CompactCardStyle}">
          <Grid>
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="45" />
              <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <Border Width="38" Height="38" Background="{StaticResource GreenSoftBrush}" CornerRadius="12">
              <TextBlock HorizontalAlignment="Center"
                         VerticalAlignment="Center"
                         FontFamily="{StaticResource SymbolFont}"
                         FontSize="17"
                         Foreground="{StaticResource GreenBrush}"
                         Text="&#xE73E;" />
            </Border>
            <StackPanel Grid.Column="1" Margin="9,0,0,0">
              <TextBlock Style="{StaticResource CaptionTextStyle}" Text="Apple device support" />
              <TextBlock Margin="0,3,0,0"
                         FontSize="13"
                         FontWeight="SemiBold"
                         Text="{Binding Devices.AppleDeviceSupport.OverallLabel}"
                         TextTrimming="CharacterEllipsis" />
            </StackPanel>
          </Grid>
        </Border>
      </Grid>

      <Grid Margin="0,18,0,0">
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="1.12*" />
          <ColumnDefinition Width="16" />
          <ColumnDefinition Width="0.88*" />
        </Grid.ColumnDefinitions>

        <Border Style="{StaticResource CardStyle}">
          <StackPanel>
            <TextBlock Style="{StaticResource SectionTitleStyle}" Text="Recent Activity" />
            <TextBlock Margin="0,4,0,14"
                       Style="{StaticResource BodyTextStyle}"
                       Text="Key actions leave a local record for this session." />
            <ListBox MaxHeight="228" ItemsSource="{Binding Activities}">
              <ListBox.ItemTemplate>
                <DataTemplate>
                  <Grid>
                    <Grid.ColumnDefinitions>
                      <ColumnDefinition Width="36" />
                      <ColumnDefinition Width="*" />
                      <ColumnDefinition Width="42" />
                    </Grid.ColumnDefinitions>
                    <Border Width="28" Height="28" CornerRadius="9">
                      <Border.Style>
                        <Style TargetType="Border">
                          <Setter Property="Background" Value="{StaticResource RedSoftBrush}" />
                          <Style.Triggers>
                            <DataTrigger Binding="{Binding IsSuccess}" Value="True">
                              <Setter Property="Background" Value="{StaticResource GreenSoftBrush}" />
                            </DataTrigger>
                          </Style.Triggers>
                        </Style>
                      </Border.Style>
                      <TextBlock HorizontalAlignment="Center"
                                 VerticalAlignment="Center"
                                 FontFamily="{StaticResource SymbolFont}"
                                 FontSize="12">
                        <TextBlock.Style>
                          <Style TargetType="TextBlock">
                            <Setter Property="Foreground" Value="{StaticResource RedBrush}" />
                            <Setter Property="Text" Value="&#xEA39;" />
                            <Style.Triggers>
                              <DataTrigger Binding="{Binding IsSuccess}" Value="True">
                                <Setter Property="Foreground" Value="{StaticResource GreenBrush}" />
                                <Setter Property="Text" Value="&#xE73E;" />
                              </DataTrigger>
                            </Style.Triggers>
                          </Style>
                        </TextBlock.Style>
                      </TextBlock>
                    </Border>
                    <StackPanel Grid.Column="1">
                      <TextBlock FontSize="13" FontWeight="SemiBold" Text="{Binding Title}" />
                      <TextBlock Margin="0,2,8,0"
                                 Style="{StaticResource CaptionTextStyle}"
                                 Text="{Binding Detail}"
                                 TextTrimming="CharacterEllipsis" />
                    </StackPanel>
                    <TextBlock Grid.Column="2"
                               HorizontalAlignment="Right"
                               Style="{StaticResource CaptionTextStyle}"
                               Text="{Binding TimeLabel}" />
                  </Grid>
                </DataTemplate>
              </ListBox.ItemTemplate>
            </ListBox>
          </StackPanel>
        </Border>

        <Border Grid.Column="2" Style="{StaticResource CardStyle}">
          <StackPanel>
            <TextBlock Style="{StaticResource SectionTitleStyle}" Text="Three Steps" />
            <TextBlock Margin="0,4,0,19"
                       Style="{StaticResource BodyTextStyle}"
                       Text="Each step can be checked and retried independently." />
            <Grid Margin="0,0,0,17">
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="39" />
                <ColumnDefinition Width="*" />
              </Grid.ColumnDefinitions>
              <Border Width="31" Height="31" Background="{StaticResource AccentSoftBrush}" CornerRadius="10">
                <TextBlock HorizontalAlignment="Center"
                           VerticalAlignment="Center"
                           FontWeight="Bold"
                           Foreground="{StaticResource AccentBrush}"
                           Text="1" />
              </Border>
              <StackPanel Grid.Column="1">
                <TextBlock FontWeight="SemiBold" Text="Connect to the App Store" />
                <TextBlock Margin="0,2,0,0" Style="{StaticResource CaptionTextStyle}" Text="Sign in and search with the official ipatool" />
              </StackPanel>
            </Grid>
            <Grid Margin="0,0,0,17">
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="39" />
                <ColumnDefinition Width="*" />
              </Grid.ColumnDefinitions>
              <Border Width="31" Height="31" Background="#E9E5FF" CornerRadius="10">
                <TextBlock HorizontalAlignment="Center"
                           VerticalAlignment="Center"
                           FontWeight="Bold"
                           Foreground="{StaticResource PurpleBrush}"
                           Text="2" />
              </Border>
              <StackPanel Grid.Column="1">
                <TextBlock FontWeight="SemiBold" Text="Download a Licensed IPA" />
                <TextBlock Margin="0,2,0,0" Style="{StaticResource CaptionTextStyle}" Text="Acquire a license and save it to your local library" />
              </StackPanel>
            </Grid>
            <Grid>
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="39" />
                <ColumnDefinition Width="*" />
              </Grid.ColumnDefinitions>
              <Border Width="31" Height="31" Background="{StaticResource GreenSoftBrush}" CornerRadius="10">
                <TextBlock HorizontalAlignment="Center"
                           VerticalAlignment="Center"
                           FontWeight="Bold"
                           Foreground="{StaticResource GreenBrush}"
                           Text="3" />
              </Border>
              <StackPanel Grid.Column="1">
                <TextBlock FontWeight="SemiBold" Text="Install on a Device" />
                <TextBlock Margin="0,2,0,0" Style="{StaticResource CaptionTextStyle}" Text="Unlock, trust, and monitor installation progress" />
              </StackPanel>
            </Grid>
          </StackPanel>
        </Border>
      </Grid>
    </StackPanel>
  </ScrollViewer>
</UserControl>
